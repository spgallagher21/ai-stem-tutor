# Client-side Firebase configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side authentication. This must match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Optional provider keys. Students can instead provide a session-only Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODELS=
GEMINI_SEARCH_MODELS=
OPENROUTER_API_KEY=

# Local API development only. Never enable this in production.
ALLOW_LOCAL_UNAUTHENTICATED=true
